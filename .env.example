# Kalodata Open API key (header X-API-Key)
KALO_API_KEY=

# LLM provider — OpenAI-compatible endpoint. Đổi provider KHÔNG cần sửa code.
# KHÔNG điền key thật vào file này — copy thành .env (gitignore) rồi điền.

# Ví dụ Anthropic (endpoint tương thích OpenAI):
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_API_KEY=
LLM_MODEL_BRIEF=claude-sonnet-5-5
LLM_MODEL_SCREEN=claude-haiku-5-5
LLM_MODEL_VIDEO=claude-opus-5-5
LLM_MODEL_REASON=claude-sonnet-5-5

# Ví dụ proxy local (LiteLLM / gateway tương thích):
# LLM_BASE_URL=http://localhost:20128/v1/
# LLM_API_KEY=...
# LLM_MODEL_SCREEN=claude-haiku   (alias tùy proxy)

# Ví dụ Gemini:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL_SCREEN=gemini-2.5-flash
# LLM_MODEL_VIDEO=gemini-2.5-pro

# Fallback chain (opt-in): mọi role fail (auth/quota/schema) → thử provider dự phòng.
# Model rỗng = tắt. Khai báo thêm per-role trong config/defaults.yaml nếu cần.
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
