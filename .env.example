# Kalodata Open API key (header X-API-Key)
KALO_API_KEY=

# LLM provider — OpenAI-compatible endpoint. Đổi provider KHÔNG cần sửa code.
# KHÔNG điền key thật vào file này — copy thành .env (gitignore) rồi điền.

# Ví dụ Anthropic (endpoint tương thích OpenAI):
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_API_KEY=
LLM_MODEL_BRIEF=claude-sonnet-5-5
LLM_MODEL_SCREEN=claude-haiku-5-5
LLM_MODEL_VIDEO=claude-opus-5-5
LLM_MODEL_REASON=claude-sonnet-5-5

# Ví dụ OpenAI-compatible gateway (OpenRouter / LiteLLM / vLLM):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=...
# LLM_MODEL_SCREEN=anthropic/claude-haiku-5-5

# Ví dụ Google Gemini (OpenAI-compatible endpoint chính thức — lưu ý có dấu / ở cuối):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=...
# LLM_MODEL_BRIEF=gemini-3.8-flash
# LLM_MODEL_SCREEN=gemini-3.8-flash
# LLM_MODEL_VIDEO=gemini-4-argon
# LLM_MODEL_REASON=gemini-4-argon

# Fallback chain toàn cục (opt-in): khi provider chính lỗi (auth/quota/404/timeout/schema),
# hệ thống tự động chuyển sang provider/model dự phòng và ghi rõ vào usage_ledger.
# Để trống LLM_FALLBACK_MODEL = tắt fallback.
# Ví dụ dùng Gemini 4 Argon làm dự phòng cho Anthropic:
# LLM_FALLBACK_MODEL=gemini-4-argon
# LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_FALLBACK_API_KEY=...
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=

# Fallback riêng cho tầng S5 (reason — prompt lớn): có thể chỉ định model mạnh hơn cùng hoặc khác provider
LLM_REASON_FALLBACK_MODEL=
LLM_REASON_FALLBACK_BASE_URL=
LLM_REASON_FALLBACK_API_KEY=
